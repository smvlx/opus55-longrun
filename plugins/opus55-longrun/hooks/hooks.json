{
  "description": "opus55-longrun: confirm destructive Bash commands; on Stop, enforce delegated checklists and notify when blocked on the user",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm-destructive.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/longrun-stop.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
